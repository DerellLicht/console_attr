{$F+}
PROCEDURE CustomDirListFormat (VAR X : DirRec;  VAR pkCat : byte;
                               VAR S : string;  D : DirListPtr);
{$F-}
{ Show only name of palette file, no extension. }

BEGIN
  S := Pad (' ' + JustName (X.Name), 10);        { final string }
  pkCat := pkNormal;                             { return normal cat }
END;

